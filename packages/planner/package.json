{
  "name": "jevellan-planner",
  "version": "0.1.0",
  "description": "The Jevellan planner: goals the owner writes once, turned into queued tasks for the bot by a planning task.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongiskhan/jevellan-monorepo.git",
    "directory": "packages/planner"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "jevellan-core": "0.1.0",
    "jevellan-memory": "0.1.0",
    "zod": "4.6.7"
  }
}
