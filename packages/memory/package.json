{
  "name": "jevellan-memory",
  "version": "0.1.0",
  "description": "Cross-agent memory: what every Jevellan agent remembers between sessions, in SQLite with FTS5 retrieval.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongiskhan/jevellan-monorepo.git",
    "directory": "packages/memory"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
