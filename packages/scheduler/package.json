{
  "name": "jevellan-scheduler",
  "version": "0.1.0",
  "description": "Schedules for Jevellan: five-field cron in a time zone, firing tasks and jobs from the bot's tick.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongiskhan/jevellan-monorepo.git",
    "directory": "packages/scheduler"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "default": "./dist/cron.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "jevellan-core": "0.1.0"
  }
}
