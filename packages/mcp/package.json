{
  "name": "jevellan-mcp",
  "version": "0.1.0",
  "description": "The control MCP of Jevellan: operate tasks, the coordinator, memory, schedules, goals and jobs from any MCP client.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongiskhan/jevellan-monorepo.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jv-mcp": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jevellan-core": "0.1.0",
    "jevellan-memory": "0.1.0",
    "jevellan-scheduler": "0.1.0",
    "zod": "4.6.7"
  }
}
